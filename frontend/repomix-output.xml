  useEffect(() => {
    api("/orders/myorders")
      .then((res) => setOrders(res.data || []))
      .catch((err) => setError(err.message))
      .finally(() => setLoading(false));
  }, []);

  if (loading) return <p className="text-slate-500">Loading orders…</p>;
  if (error) return <p className="text-red-600">{error}</p>;

