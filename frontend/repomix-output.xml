                <StatusBadge status={o.orderStatus} />
                <StatusBadge status={o.paymentStatus} />
              </div>

              <p className="text-lg font-bold">{formatPrice(o.totalPrice)}</p>
            </div>
          </Link>
        ))}
      </div>
    </div>
  );
}
