            </NavLink>
          )}

          {user ? (
            <button onClick={handleLogout} className="btn-outline">
              Logout
            </button>
          ) : (
            <>
              <Link
                to="/login"
                className="text-sm font-medium text-slate-600 hover:text-slate-900"
              >
                Login
              </Link>
              <Link to="/register" className="btn-primary">
